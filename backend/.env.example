# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Ma'lumotlar bazasi (PostgreSQL) ----
# `npm run db:start` lokal PostgreSQL'ni shu login/parol/port bilan ishga tushiradi.
# O'zingizning PostgreSQL'ingiz bo'lsa, shu manzilni moslang.
DATABASE_URL=postgresql://edulearn:edulearn_local_pw@localhost:5433/edulearn

# ---- JWT ----
# Kamida 32 belgili tasodifiy satr. Yaratish:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=bu_yerga_uzun_tasodifiy_satr_yozing
JWT_EXPIRES_IN=7d

# ---- Cookie / CORS ----
# Frontend boshqa domenda bo'lsa (Vercel + Render): COOKIE_SAMESITE=none va HTTPS shart
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173

# ---- Seed (test ma'lumotlari) ----
# FAQAT lokal ishlab chiqish uchun. Productionda albatta o'zgartiring!
SEED_ADMIN_EMAIL=admin@edulearn.uz
SEED_ADMIN_PASSWORD=Admin12345
SEED_DEMO_PASSWORD=Parol12345
