// EduLearn — ma'lumotlar bazasi sxemasi (PostgreSQL + Prisma)
//
// Munosabatlar:
//   User (o'qituvchi) 1 ──< N Course        teacherId
//   Category          1 ──< N Course        categoryId
//   Course            1 ──< N Lesson        courseId
//   User (talaba)     N >──< N Course       Enrollment orqali
//   User (talaba)     N >──< N Lesson       LessonProgress orqali

generator client {
  provider = "prisma-client-js"
}

// Ulanish manzili (DATABASE_URL) prisma.config.ts da beriladi
datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  SUPER_ADMIN
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// DRAFT -> (o'qituvchi yuboradi) PENDING -> (admin tasdiqlaydi) PUBLISHED
// Admin istalgan vaqtda ARCHIVED (yashirilgan) qila oladi.
enum CourseStatus {
  DRAFT
  PENDING
  PUBLISHED
  ARCHIVED
}

model User {
  id           Int      @id @default(autoincrement())
  firstName    String   @db.VarChar(60)
  lastName     String   @db.VarChar(60)
  email        String   @unique @db.VarChar(120)
  passwordHash String
  role         Role     @default(STUDENT)
  bio          String?  @db.VarChar(300)
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // O'qituvchi kurslari. Kursi bor o'qituvchini o'chirib bo'lmaydi (Restrict).
  courses     Course[]         @relation("TeacherCourses")
  enrollments Enrollment[]
  progress    LessonProgress[]

  @@index([role])
  @@map("users")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(60)
  slug      String   @unique @db.VarChar(80)
  createdAt DateTime @default(now())

  courses Course[]

  @@map("categories")
}

model Course {
  id           Int          @id @default(autoincrement())
  title        String       @db.VarChar(150)
  slug         String       @unique @db.VarChar(100)
  description  String
  thumbnailUrl String?
  level        CourseLevel  @default(BEGINNER)
  status       CourseStatus @default(DRAFT)
  teacherId    Int
  categoryId   Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  teacher     User         @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: Restrict)
  // Kurslari bor kategoriyani o'chirib bo'lmaydi — avval kurslarni boshqa kategoriyaga o'tkazish kerak.
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  lessons     Lesson[]
  enrollments Enrollment[]

  @@index([status])
  @@index([teacherId])
  @@index([categoryId])
  @@map("courses")
}

model Lesson {
  id              Int      @id @default(autoincrement())
  courseId        Int
  title           String   @db.VarChar(150)
  content         String
  videoUrl        String?
  durationMinutes Int      @default(10)
  orderIndex      Int
  // isPreview = true bo'lsa dars matnini kursga yozilmagan odam ham ko'ra oladi
  isPreview       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Kurs o'chirilsa uning darslari ham o'chadi
  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([courseId, orderIndex])
  @@map("lessons")
}

model Enrollment {
  id         Int      @id @default(autoincrement())
  studentId  Int
  courseId   Int
  enrolledAt DateTime @default(now())

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Bitta talaba bitta kursga faqat bir marta yoziladi
  @@unique([studentId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  id          Int      @id @default(autoincrement())
  studentId   Int
  lessonId    Int
  completedAt DateTime @default(now())

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  // Bitta darsni ikki marta "tugatdim" qilish takroriy yozuv yaratmaydi
  @@unique([studentId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

// Bog'lanish formasi orqali kelgan xabarlar (admin panelda ko'rinadi)
model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(80)
  email     String   @db.VarChar(120)
  subject   String?  @db.VarChar(150)
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}
